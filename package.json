{
  "name": "kumora-backend",
  "version": "0.1.0",
  "private": true,
  "description": "Kumora backend — REST API (Express), API-only service",
  "scripts": {
    "dev": "tsx watch server/server.ts",
    "build": "npm run build:server",
    "build:server": "tsc -p tsconfig.json",
    "start": "node dist/server.js",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.58.0",
    "cors": "^2.8.6",
    "dotenv": "^17.3.1",
    "express": "^5.1.0",
    "multer": "^2.4.0"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.3",
    "@types/multer": "^2.2.0",
    "@types/node": "^24.5.2",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3"
  }
}
